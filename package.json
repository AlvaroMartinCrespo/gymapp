{
  "name": "gymapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "predev": "npm run icons",
    "dev": "next dev",
    "prebuild": "npm run icons",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
